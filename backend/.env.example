# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Supabase PostgreSQL Storage (Optional)
# If left blank or unconfigured, the system automatically uses local SQLite and local file storage.
SUPABASE_URL=
SUPABASE_KEY=

# Local LLM Inference (Optional)
# Set to 'true' to attempt loading Qwen/Qwen2.5-1.5B-Instruct into memory.
# Default 'false' uses fast, deterministic rule-based contextual extraction grounded in OCR text.
ENABLE_LOCAL_LLM=false

